# Backend (FastAPI) base URL
VITE_API_BASE_URL=http://localhost:8000

# Chat context sent automatically with every /api/chat request
VITE_DEFAULT_USER_ID=user123
VITE_DEFAULT_STORE_ID=STORE_1
VITE_DEFAULT_SESSION_ID=SESSION_1

# Optional tuning
VITE_API_TIMEOUT_MS=60000
VITE_PRODUCTS_PAGE_SIZE=12
VITE_MAX_QUANTITY_PER_ITEM=10
