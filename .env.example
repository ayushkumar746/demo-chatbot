# Google Gemini (the only LLM / embedding provider)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Chat model used by the planner. Must support generateContent for your key;
# run `python check_gemini.py` to list the models available to your key.
GEMINI_MODEL=gemini-3.5-flash-lite
# Embedding model used for the product vector index (re-run seed_products.py after changing)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
# Seed throttling: embedded texts per minute (free tier limit is 100; 0 disables)
SEED_EMBEDDINGS_PER_MINUTE=90

# Local vector database (Chroma), relative to the project root
VECTOR_DB_PATH=data/vector_db
VECTOR_COLLECTION_NAME=products
# A JSON file or a directory of JSON files (all *.json are loaded)
PRODUCT_CATALOG_PATH=data/products

# Semantic search tuning (cosine distance; lower = more similar)
SEARCH_TOP_K=100
SEARCH_MAX_DISTANCE=0.41
SEARCH_RELEVANCE_MARGIN=0.04

# Application Configuration
APP_NAME=Chatbot API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Allowed browser origins (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://localhost:3000"]

# Base URL used in product image URLs (images are served from /static)
PUBLIC_BASE_URL=http://localhost:8000

# Store Configuration
DEFAULT_STORE_ID=STORE_1

# Selection Policy
SELECTION_POLICY=CHEAPEST_MATCH
# Options: CHEAPEST_MATCH, ASK_CONFIRMATION, FIRST_MATCH

# Cart Validation
MAX_CART_ITEMS=50
MAX_QUANTITY_PER_ITEM=10
